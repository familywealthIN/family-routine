---
import { Icon } from 'astro-icon/components';
import { searchIndex } from '~/lib/help';

interface Props {
  /** `hero` is the big box on the help home page; `bar` is the compact one. */
  variant?: 'hero' | 'bar';
  placeholder?: string;
}

const { variant = 'bar', placeholder = 'Search for an answer…' } = Astro.props;

// Serialised at build time — search never hits the network.
const index = searchIndex();
---

<div class={`help-search help-search--${variant}`} data-help-search>
  <label class="sr-only" for={`help-search-${variant}`}>Search the help centre</label>
  <div class="help-search__field">
    <Icon name="ph:magnifying-glass" width={18} height={18} class="help-search__icon" />
    <input
      id={`help-search-${variant}`}
      type="search"
      autocomplete="off"
      placeholder={placeholder}
      class="help-search__input"
      role="combobox"
      aria-expanded="false"
      aria-controls={`help-search-results-${variant}`}
      aria-autocomplete="list"
    />
  </div>
  <div
    class="help-search__results"
    id={`help-search-results-${variant}`}
    role="listbox"
    hidden
  >
  </div>
</div>

<script is:inline set:html={`window.__RN_HELP_INDEX__ = ${JSON.stringify(index)};`} />

<script>
  interface Entry {
    slug: string;
    title: string;
    summary: string;
    category: string;
    categoryLabel: string;
    text: string;
  }

  function score(entry: Entry, terms: string[]): number {
    const title = entry.title.toLowerCase();
    let total = 0;
    for (const term of terms) {
      if (!entry.text.includes(term)) return 0; // every term must appear
      if (title === term) total += 100;
      else if (title.startsWith(term)) total += 40;
      else if (title.includes(term)) total += 25;
      if (entry.summary.toLowerCase().includes(term)) total += 8;
      total += 1;
    }
    return total;
  }

  function escapeHtml(value: string): string {
    const map: Record<string, string> = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    };
    return value.replace(/[&<>"']/g, (ch) => map[ch]);
  }

  function initSearch() {
    const entries: Entry[] = (window as any).__RN_HELP_INDEX__ ?? [];

    document.querySelectorAll<HTMLElement>('[data-help-search]').forEach((root) => {
      const input = root.querySelector<HTMLInputElement>('.help-search__input');
      const results = root.querySelector<HTMLElement>('.help-search__results');
      if (!input || !results || input.dataset.bound === 'true') return;
      input.dataset.bound = 'true';

      let active = -1;

      const close = () => {
        results.hidden = true;
        results.innerHTML = '';
        input.setAttribute('aria-expanded', 'false');
        active = -1;
      };

      const setActive = (next: number) => {
        const options = results.querySelectorAll<HTMLElement>('[role="option"]');
        if (!options.length) return;
        active = (next + options.length) % options.length;
        options.forEach((option, i) => {
          option.classList.toggle('is-active', i === active);
          option.setAttribute('aria-selected', String(i === active));
        });
        options[active].scrollIntoView({ block: 'nearest' });
      };

      const run = () => {
        const query = input.value.trim().toLowerCase();
        if (query.length < 2) return close();

        const terms = query.split(/\s+/).filter(Boolean);
        const hits = entries
          .map((entry) => ({ entry, score: score(entry, terms) }))
          .filter((hit) => hit.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 8);

        if (!hits.length) {
          results.innerHTML =
            '<p class="help-search__empty">No results. Try a different word, or <a href="mailto:support@familywealth.in">email support</a>.</p>';
          results.hidden = false;
          input.setAttribute('aria-expanded', 'true');
          return;
        }

        results.innerHTML = hits
          .map(
            ({ entry }) => `
              <a class="help-search__hit" role="option" aria-selected="false" href="/help/articles/${entry.slug}">
                <span class="help-search__hit-title">${escapeHtml(entry.title)}</span>
                <span class="help-search__hit-cat">${escapeHtml(entry.categoryLabel)}</span>
                <span class="help-search__hit-summary">${escapeHtml(entry.summary)}</span>
              </a>`,
          )
          .join('');
        results.hidden = false;
        input.setAttribute('aria-expanded', 'true');
        active = -1;
      };

      input.addEventListener('input', run);
      input.addEventListener('focus', run);

      input.addEventListener('keydown', (event) => {
        const options = results.querySelectorAll<HTMLElement>('[role="option"]');
        if (event.key === 'Escape') return close();
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          setActive(active + 1);
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          setActive(active - 1);
        } else if (event.key === 'Enter' && active >= 0 && options[active]) {
          event.preventDefault();
          (options[active] as HTMLAnchorElement).click();
        }
      });

      document.addEventListener('click', (event) => {
        if (!root.contains(event.target as Node)) close();
      });
    });
  }

  initSearch();
  document.addEventListener('astro:page-load', initSearch);
</script>
