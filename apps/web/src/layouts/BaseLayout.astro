---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '~/lib/links';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Alt text for og:image / twitter:image. */
  ogImageAlt?: string;
  /** 'article' on blog posts; 'website' everywhere else. */
  ogType?: 'website' | 'article';
  /** Blog posts: ISO dates for article:published_time / modified_time. */
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = `${SITE.name} — Show up daily. Evolve weekly.`,
  description = SITE.description,
  ogImage = '/og.png',
  ogImageAlt,
  ogType = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

const site = Astro.site ?? 'https://routinenotes.app';
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImageUrl = new URL(ogImage, site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageUrl} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#288bd5" />

    <ClientRouter />

    <!-- Hide the [data-reveal] sections before first paint, so they fade in once
         instead of showing, vanishing and fading in. A view-transition swap brings
         a fresh <html> without the class, so it is re-added after each swap. If
         motion.ts never runs, the sections are shown again. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js-ready');
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.classList.add('js-ready');
        });
        setTimeout(function () {
          if (!window.__revealReady) document.documentElement.classList.remove('js-ready');
        }, 3000);
      })();
    </script>
  </head>
  <body class="bg-[color:var(--color-surface)] text-[color:var(--color-ink-900)]">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-white focus:px-3 focus:py-2 focus:shadow"
    >
      Skip to content
    </a>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '~/lib/motion.ts';
    </script>
  </body>
</html>
